# Variáveis do docker-compose.yml (produção / Coolify). Copie para .env (fora do git).
POSTGRES_PASSWORD=troque-esta-senha
# true em produção com HTTPS. Em teste local via http://localhost:8080 use false.
COOKIE_SECURE=true
# Diretor criado por "docker compose exec api node dist/setup.js" se não houver nenhum usuário com login.
ADMIN_NOME=Otavio
ADMIN_EMAIL=otavio@campestre.social.br
# Vazio = gera uma senha e imprime uma única vez no terminal.
ADMIN_SENHA=
