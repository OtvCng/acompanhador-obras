{
  "name": "acompanhador-obras",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter @obras/web dev",
    "dev:api": "pnpm --filter @obras/api dev",
    "db:subir": "docker compose -f docker-compose.dev.yml up -d",
    "db:setup": "pnpm --filter @obras/api db:setup",
    "db:exemplos": "pnpm --filter @obras/api db:exemplos",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.8.9",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "rollup": "npm:@rollup/wasm-node@4.52.4"
    }
  }
}
