{
  "name": "@obras/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx --env-file-if-exists=.env src/scripts/migrar.ts",
    "db:setup": "tsx --env-file-if-exists=.env src/scripts/setup.ts",
    "db:exemplos": "tsx --env-file-if-exists=.env src/scripts/exemplos.ts",
    "usuario:criar": "tsx --env-file-if-exists=.env src/scripts/criar-usuario.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@obras/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
