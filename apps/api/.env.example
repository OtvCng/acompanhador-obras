# Copie para .env (o .env não vai para o git).
# Postgres do docker-compose.dev.yml (porta 5433 no host).
DATABASE_URL=postgres://obras:obras@127.0.0.1:5433/obras
PORT=3333
HOST=127.0.0.1
# Em produção (HTTPS) use true, para o cookie de sessão sair com Secure.
COOKIE_SECURE=false
# Diretor criado pelo "pnpm db:setup" se ainda não existir nenhum usuário.
ADMIN_NOME=Otavio
ADMIN_EMAIL=otavio@campestre.social.br
# Vazio = o setup gera uma senha aleatória e imprime uma única vez.
ADMIN_SENHA=
